#!/bin/bash
# FIRST CHECK PACKAGE
HAS_PACKAGE_CONFIG=$(cat package.json 2>/dev/null | grep "auto-changelog" | head -1)
# Resolve the bin symlink to find the package folder (standard node, nvm, npm link)
resolve_self() {
    realpath "$0" 2>/dev/null \
        || readlink -f "$0" 2>/dev/null \
        || node -e 'console.log(require("fs").realpathSync(process.argv[1]))' "$0"
}
FULL_PATH_BIN=${AWESOME_RELEASE_HOME:-$(dirname "$(resolve_self)")}
if [ ! -z ${DEBUG} ]; then
    set -x
fi
set -e
set -o pipefail

MASTER_BRANCH_FROM_ENV=${MASTER_BRANCH}
DEVELOP_BRANCH=${DEVELOP_BRANCH:-develop}
ORIGIN_REMOTE=${ORIGIN_REMOTE:-origin}

DEFAULT_INITIAL_VERSION=${DEFAULT_INITIAL_VERSION:-0.0.0}

for lib_file in ui.sh is_installed.sh; do
    if [ ! -f "$FULL_PATH_BIN/lib/$lib_file" ]; then
        echo "awesome-release files not found in $FULL_PATH_BIN. Set AWESOME_RELEASE_HOME."
        exit 1
    fi
done
source "$FULL_PATH_BIN/lib/ui.sh"
source "$FULL_PATH_BIN/lib/is_installed.sh"

no_test=
yes_to_all=
short_tags=
dry_run=

release_part=
while true ; do
    case "$1" in
    (-y|--yes-to-all) yes_to_all=1;;
    (-s|--short-tags) short_tags=1;;
    (-d|--dry-run) dry_run=1;;
    (-h|--help) print_help;;
    # for options with required arguments, an additional shift is required
    (-i|--increment)
        case "$2" in
        # for options with required arguments, an additional shift is required
        "major"|"minor"|"patch") release_part=$2;;
        (*) echo "$0: error - invalid value for -i option $1" 1>&2; print_help 1;;
        esac
        shift
    ;;
    (-r|--remote)
        ORIGIN_REMOTE=$2
        shift
    ;;
    (--no-test) no_test=1;;
    (--) shift; break;;
    (-*) echo "$0: error - unrecognized option $1" 1>&2; print_help 1;;
    ("") break;;
    (*) echo "$0: error - unrecognized option $1" 1>&2; print_help 1;;
    esac
    shift
done

ui_header

# ── 1. Dependencies ────────────────────────────────────────────────
ui_step 1 "Dependencies"
test_requirements || exit 1

# the release commit must contain only what the script generates: changes left in
# the working tree would follow the checkout to the release branch and be committed
# and pushed with the release (and the rollback reset would discard them)
if [ -n "$(git status --porcelain)" ]; then
    echo
    ui_error "Working tree is not clean. Commit or stash your changes before releasing:"
    git status --short | sed 's/^/      /'
    echo
    exit 1
fi
ui_ok "Working tree is clean"

branch_exists() {
    [ -n "$(git branch -la --format "%(refname:short)" "${ORIGIN_REMOTE}/$1")" ]
}

if [ -n "${MASTER_BRANCH_FROM_ENV}" ]; then
    MASTER_BRANCH=${MASTER_BRANCH_FROM_ENV}
    if ! branch_exists "$MASTER_BRANCH"; then
        echo
        ui_error "$MASTER_BRANCH branch not found on ${ORIGIN_REMOTE}"
        echo
        print_help 1
    fi
elif branch_exists master; then
    MASTER_BRANCH=master
elif branch_exists main; then
    MASTER_BRANCH=main
else
    echo
    ui_error "Neither master nor main branch found on ${ORIGIN_REMOTE}"
    echo
    print_help 1
fi

# ── 2. Checkout ────────────────────────────────────────────────────
ui_step 2 "Checkout ${MASTER_BRANCH}"
if [ "$MASTER_BRANCH" = main ] && [ -z "${MASTER_BRANCH_FROM_ENV}" ]; then
    ui_warn "master branch not found, using ${bold}main${normal}"
fi
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
ui_run "Checkout $MASTER_BRANCH" git checkout $MASTER_BRANCH
if [ `git ls-remote --heads $ORIGIN_REMOTE $MASTER_BRANCH | wc -l` -gt 0 ]; then
    ui_run "Pull $ORIGIN_REMOTE/$MASTER_BRANCH" git pull $ORIGIN_REMOTE $MASTER_BRANCH
fi
ui_run "Fetch tags" git fetch --tags

# ── 3. Merge ───────────────────────────────────────────────────────
ui_step 3 "Merge"
ui_ask BRANCH_SOURCE "Merge from which branch into ${bold}$MASTER_BRANCH${normal}?" "$DEVELOP_BRANCH"
ui_run "Fetch $ORIGIN_REMOTE" git fetch $ORIGIN_REMOTE
MERGE_COUNT=$(git rev-list --count "HEAD..$ORIGIN_REMOTE/$BRANCH_SOURCE" 2>/dev/null || echo "?")
if [ "$MERGE_COUNT" = 1 ]; then MERGE_LABEL="1 commit"; else MERGE_LABEL="$MERGE_COUNT commits"; fi
ui_run "Merge $BRANCH_SOURCE → $MASTER_BRANCH ${dim}($MERGE_LABEL)${normal}" git merge $ORIGIN_REMOTE/$BRANCH_SOURCE

# ── 4. Tag ─────────────────────────────────────────────────────────
ui_step 4 "Tag"
TAG_PREFIX=v
LAST_TAG=$(git tag --sort=-creatordate | head -n 1)
TAG_WITHOUT_PREFIX="${LAST_TAG#${TAG_PREFIX}}"
if [ "$LAST_TAG" = "$TAG_WITHOUT_PREFIX" ]; then
    TAG_PREFIX=
fi
ui_kv "Last tag" "${LAST_TAG:-none}"
NEXT_TAG=$(semver -i $release_part ${TAG_WITHOUT_PREFIX:-${DEFAULT_INITIAL_VERSION}} || echo ${DEFAULT_INITIAL_VERSION})

ui_ask NEW_TAG "Which tag do you want to release (without prefix)?" "$NEXT_TAG"
NEW_MAJOR=$(echo $NEW_TAG | cut -d '.'  -f1)
NEW_MINOR=$(echo $NEW_TAG | cut -d '.'  -f2)
ui_kv "New tag" "${TAG_PREFIX}${NEW_TAG}"
ui_kv "Major" "$NEW_MAJOR"
ui_kv "Minor" "$NEW_MINOR"

if [ -z ${short_tags} ]; then
    if ui_confirm "Generate short tags ${bold}${TAG_PREFIX}${NEW_MAJOR}${normal} and ${bold}${TAG_PREFIX}${NEW_MAJOR}.$NEW_MINOR${normal}?"; then
        short_tags=1
    fi
fi

if [ -z ${no_test} ] && [ -f tox.ini ]; then
    ui_info "Running tox"
    ui_rule
    tox -r
    ui_rule
fi

# ── 5. Bump version ────────────────────────────────────────────────
ui_step 5 "Bump version to ${TAG_PREFIX}${NEW_TAG}"
bumped=

if [ -f .bumpversion.cfg ] && [ "$(program_is_installed bump2version)" = 1 ]; then
    ui_info "Running bump2version ${dim}(.bumpversion.cfg)${normal}"
    ui_rule
    bump2version --verbose --allow-dirty --new-version $NEW_TAG $NEW_TAG
    ui_rule
    bumped=1
fi

if [ -f pom.xml ]; then
    ui_info "Running maven ${dim}(pom.xml)${normal}"
    ui_rule
    MVN_OPTS=
    if [ ! -z ${no_test} ]; then
        MVN_OPTS=-Dmaven.test.skip=true
    fi
    if [ -f mvnw ]; then
        ./mvnw clean package ${MVN_OPTS}
    else
        mvn clean package ${MVN_OPTS}
    fi
    mvn versions:set -DnewVersion=$NEW_TAG
    ui_rule
    bumped=1
fi

if [ -f gradle.properties ]; then
    ui_run "Update gradle.properties" perl -pi -e "s/version=.*/version=${NEW_TAG}/g" gradle.properties
    bumped=1
fi
if [ -f build.gradle ] || [ -f build.gradle.kts ]; then
    GRADLE_OPTS=
    if [ ! -z ${no_test} ]; then
        GRADLE_OPTS=-xtest
    fi
    ui_info "Running gradle ${dim}(build.gradle)${normal}"
    ui_rule
    if [ -f gradlew ]; then
        ./gradlew build ${GRADLE_OPTS}
    else
        gradle build ${GRADLE_OPTS}
    fi
    ui_rule
    bumped=1
fi

if [ -f package.json ]; then
    ui_run "Update package.json" npm --no-git-tag-version version $NEW_TAG
    bumped=1
fi

if [ -z ${bumped} ]; then
    ui_info "No version files found, only the tag will be created"
fi

# ── 6. Changelog ───────────────────────────────────────────────────
ui_step 6 "Changelog"
if [ ! "$HAS_PACKAGE_CONFIG" ]; then
    ui_run "Generate CHANGELOG.md" auto-changelog -v "${TAG_PREFIX}${NEW_TAG}" --template "$FULL_PATH_BIN"/lib/template.hbs -u
else
    ui_run "Generate CHANGELOG.md" auto-changelog -v "${TAG_PREFIX}${NEW_TAG}"
fi

echo
ui_rule
# indent the preview to the same margin as the steps; cli-md only keeps its colors
# through the pipe when --color comes after the input file
CLI_MD_OPTS=
if [ -n "$normal" ]; then
    CLI_MD_OPTS=--color
fi
head -n 25 CHANGELOG.md | cli-md /dev/stdin $CLI_MD_OPTS | sed 's/^/    /'
ui_rule

# ── 7. Release ─────────────────────────────────────────────────────
ui_step 7 "Release"
if [ -n "${dry_run}" ]; then
    ui_warn "Dry run: nothing will be committed or pushed"
fi

# only tracked files bumped by the release plus the changelog, which may be new:
# untracked files created during the release (build output, backups) stay out
ui_run "Stage changes" git add --update
ui_run "Stage CHANGELOG.md" git add CHANGELOG.md
ui_info "Release commit:"
git diff --cached --name-status | sed 's/^/      /'

if ! ui_confirm "Alright! Release tag ${bold}${TAG_PREFIX}${NEW_TAG}${normal}?" "$yes_to_all"; then
    # release cancelled: rollback
    ui_warn "Release cancelled, rolling back"
    ui_run "Reset to $ORIGIN_REMOTE/$MASTER_BRANCH" git reset --hard $ORIGIN_REMOTE/$MASTER_BRANCH
    ui_run "Back to $CURRENT_BRANCH" git checkout $CURRENT_BRANCH
    echo
    echo "  ${dim}Bye.${normal}"
    echo
    exit 0
fi

if [ -z ${dry_run} ]; then
    ui_run "Commit release ${TAG_PREFIX}${NEW_TAG}" git commit -m ":bookmark: Release version: ${TAG_PREFIX}${NEW_TAG}"
else
    ui_run "Commit release ${TAG_PREFIX}${NEW_TAG} ${dim}(dry run)${normal}" git commit -m ":bookmark: Release version: ${TAG_PREFIX}${NEW_TAG}" --dry-run
fi

if [ -z ${dry_run} ] && [ ! -z ${short_tags} ]; then
    ui_run "Tag ${TAG_PREFIX}${NEW_MAJOR}" git tag -f ${TAG_PREFIX}${NEW_MAJOR}
    ui_run "Tag ${TAG_PREFIX}${NEW_MAJOR}.$NEW_MINOR" git tag -f ${TAG_PREFIX}${NEW_MAJOR}.$NEW_MINOR
fi

summary=("tag=${TAG_PREFIX}${NEW_TAG}")
if [ ! -z ${short_tags} ]; then
    summary+=("short tags=${TAG_PREFIX}${NEW_MAJOR}, ${TAG_PREFIX}${NEW_MAJOR}.$NEW_MINOR")
fi
summary+=("merge=$BRANCH_SOURCE → $MASTER_BRANCH")

if [ -z ${dry_run} ]; then
    ui_run "Tag ${TAG_PREFIX}${NEW_TAG}" git tag ${TAG_PREFIX}${NEW_TAG}
    ui_run "Checkout $DEVELOP_BRANCH" git checkout $DEVELOP_BRANCH
    ui_run "Merge ${TAG_PREFIX}${NEW_TAG} → $DEVELOP_BRANCH" git merge --no-ff --no-edit ${TAG_PREFIX}${NEW_TAG}
    ui_run "Push $MASTER_BRANCH and tags" git push $ORIGIN_REMOTE $MASTER_BRANCH --tags --force
    ui_run "Push $DEVELOP_BRANCH" git push $ORIGIN_REMOTE $DEVELOP_BRANCH
    summary+=("pushed=$MASTER_BRANCH, $DEVELOP_BRANCH, tags → $ORIGIN_REMOTE")
else
    ui_run "Reset to $ORIGIN_REMOTE/$MASTER_BRANCH" git reset --hard $ORIGIN_REMOTE/$MASTER_BRANCH
    ui_run "Back to $CURRENT_BRANCH" git checkout $CURRENT_BRANCH
    summary+=("pushed=nothing (dry run)")
fi

ui_box "Release summary" "${summary[@]}"
echo
echo "  ${green}${bold}All right!${normal} ${dim}Bye.${normal}"
echo
