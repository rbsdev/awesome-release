{
  "name": "awesome-release",
  "version": "2.0.4",
  "description": "CLI that automates releases: bumps the version, creates the git tag and generates the CHANGELOG from merged pull requests",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "preinstall": "npm i -g auto-changelog@^2 cli-md@^1 semver@^7",
    "update": "bash ./update.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbsdev/awesome-release.git"
  },
  "author": "Nucleo Digital / Grupo RBS",
  "license": "ISC",
  "dependencies": {
    "auto-changelog": "^2.7.0",
    "cli-md": "^1.2.0",
    "semver": "^7.8.6"
  },
  "bin": "./awesome-release",
  "directories": {
    "lib": "./lib"
  },
  "auto-changelog": {
    "template": "lib/template.hbs"
  }
}
